datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============ RBAC Models ============

model Role {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  name  String @unique
  roles Role[]

  @@map("permissions")
}

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  managerId String?
  manager   User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members   User[]   @relation("TeamMembers")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("teams")
}

model User {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  roleId   String
  role     Role    @relation(fields: [roleId], references: [id])
  teamId   String?
  team     Team?   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)

  managedTeams Team[] @relation("TeamManager")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads        Lead[]        @relation("AttendantLeads")
  negotiations Negotiation[]
  auditLogs    AuditLog[]

  @@map("users")
}

// ============ Business Models ============

enum LeadStatus {
  novo
  em_atendimento
  agendado
  em_negociacao
  convertido
  perdido
}

model Lead {
  id          String     @id @default(cuid())
  attendantId String
  attendant   User       @relation("AttendantLeads", fields: [attendantId], references: [id], onDelete: Cascade)
  clientName  String
  clientEmail String?
  clientPhone String?
  clientCpf   String?
  origin      String
  importance  String
  status      LeadStatus @default(novo)
  archive     Boolean    @default(false)
  storeId     String?

  subject            String?
  firstInteractionAt DateTime?
  externalId         String?   @unique

  estimatedValue   Decimal? @db.Decimal(12, 2)
  potentialRevenue Decimal? @db.Decimal(12, 2)
  winProbability   Int?

  negotiation    Negotiation?
  financeEntries FinanceEntry[] @relation("LeadFinance")
  agendaEvents   AgendaEvent[]  @relation("LeadAgenda")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
  @@index([archive])
}

model Negotiation {
  id     String  @id @default(cuid())
  leadId String  @unique
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  stage     String
  status    String
  importance String
  notes     String?

  history NegotiationHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("negotiations")
}

model NegotiationHistory {
  id            String      @id @default(cuid())
  negotiationId String
  negotiation   Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)

  previousStage  String?
  newStage       String?
  previousStatus String?
  newStatus      String?
  reason         String?

  createdAt DateTime @default(now())

  @@map("negotiation_history")
}

model AuditLog {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  entityType String
  entityId   String
  action     String
  changes    Json?

  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([entityType, entityId])
}

// ============ Document Module ============

enum DocumentType {
  File
  Link
}

enum DocumentVisibility {
  private
  public
}

model Document {
  id               String             @id @default(cuid())
  companyId        String
  title            String
  description      String?
  type             DocumentType
  url              String?
  storedFileName   String?
  originalFileName String?
  contentType      String?
  sizeBytes        Int?
  sector           String?
  category         String?
  tagsJson         Json?
  isOnboarding     Boolean            @default(false)
  visibility       DocumentVisibility @default(private)
  ownerId          String?
  deletedAt        DateTime?
  createdAtUtc     DateTime           @default(now())
  updatedAtUtc     DateTime           @updatedAt
  createdBy        String?
  updatedBy        String?

  @@map("documents")
  @@index([companyId])
  @@index([companyId, visibility])
  @@index([companyId, sector])
}

// ============ Finance Module ============

enum FinanceEntryType {
  income
  expense
}

enum FinanceEntryStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model FinanceEntry {
  id                 String             @id @default(cuid())
  companyId          String
  type               FinanceEntryType
  status             FinanceEntryStatus @default(PENDING)
  category           String
  amount             Decimal            @db.Decimal(12, 2)
  currency           String             @default("BRL")
  notes              String?
  attachmentFileName String?
  costCenter         String?
  dueDate            DateTime
  paidDate           DateTime?
  occurredAtUtc      DateTime           @default(now())
  leadId             String?
  lead               Lead?              @relation("LeadFinance", fields: [leadId], references: [id], onDelete: SetNull)
  createdAtUtc       DateTime           @default(now())
  updatedAtUtc       DateTime           @updatedAt
  createdBy          String?
  updatedBy          String?

  @@map("finance_entries")
  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

// ============ Agenda Module ============

enum AgendaEventType {
  test_drive
  visit
  meeting
  call
  follow_up
  delivery
}

enum AgendaEventStatus {
  pending
  confirmed
  cancelled
  completed
}

model AgendaEvent {
  id          String            @id @default(cuid())
  companyId   String
  title       String
  type        AgendaEventType
  status      AgendaEventStatus @default(pending)
  scheduledAt DateTime
  clientName  String
  vehicleName String?
  assignedTo  String?
  notes       String?
  leadId      String?
  lead        Lead?             @relation("LeadAgenda", fields: [leadId], references: [id], onDelete: SetNull)
  createdAtUtc DateTime @default(now())
  updatedAtUtc DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  @@map("agenda_events")
  @@index([companyId])
  @@index([companyId, scheduledAt])
  @@index([companyId, status])
}
