datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============ RBAC Models ============

model Role {
  id          String       @id @default(cuid())
  name        String       @unique // ATENDENTE, GERENTE, GERENTE_GERAL, ADMIN
  description String?
  users       User[]
  permissions Permission[]

  @@map("roles")
}

model Permission {
  id    String   @id @default(cuid())
  name  String   @unique // criar_lead, editar_lead, ver_dashboard, etc
  roles Role[]

  @@map("permissions")
}

model Team {
  id          String   @id @default(cuid())
  name        String   @unique
  managerId   String?
  manager     User?    @relation("TeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  members     User[]   @relation("TeamMembers")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("teams")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  teamId    String?
  team      Team?    @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  
  // Relacionamento com liderança de time
  managedTeams Team[] @relation("TeamManager")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos com negócio
  leads              Lead[]        @relation("AttendantLeads")
  negotiations       Negotiation[]
  auditLogs          AuditLog[]

  @@map("users")
}

// ============ Business Models ============

// Funil de vendas: padroniza os estagios do lead e evita erros de digitacao (Sprint 2).
enum LeadStatus {
  novo
  em_atendimento
  agendado
  em_negociacao
  convertido
  perdido
}

model Lead {
  id              String       @id @default(cuid())
  attendantId     String
  attendant       User         @relation("AttendantLeads", fields: [attendantId], references: [id], onDelete: Cascade)
  clientName      String
  clientEmail     String?
  clientPhone     String?
  clientCpf       String?
  origin          String       // visita_loja, telefone, whatsapp, instagram, formulario, outro
  importance      String       // frio, morno, quente
  status          LeadStatus   @default(novo)
  archive         Boolean      @default(false) // leads finalizados/perdidos arquivados saem do funil ativo
  storeId         String?

  subject            String?
  firstInteractionAt DateTime?
  externalId         String? @unique


  negotiation     Negotiation?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("leads")
  @@index([archive])
}

model Negotiation {
  id              String   @id @default(cuid())

  leadId          String   @unique
  lead            Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  stage           String   // estagio atual da negociacao
  status          String   // status atual da negociacao
  importance      String   // frio, morno, quente
  notes           String?

  history         NegotiationHistory[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("negotiations")
}

model NegotiationHistory {
  id              String   @id @default(cuid())
  negotiationId   String
  negotiation     Negotiation @relation(fields: [negotiationId], references: [id], onDelete: Cascade)
  
  previousStage   String?
  newStage        String?
  previousStatus  String?
  newStatus       String?
  reason          String?
  
  createdAt       DateTime @default(now())

  @@map("negotiation_history")
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  entityType      String   // user, lead, team, negotiation
  entityId        String
  action          String   // create, update, delete, login
  changes         Json?
  
  createdAt       DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
  @@index([entityType, entityId])
}
